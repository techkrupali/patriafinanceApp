# Copy to deploy/deploy.env on the server and edit. deploy/deploy.env is not committed.

# The git checkout on the server (defaults to the folder above deploy/).
# APP_ROOT=/var/www/patriafinanceApp
BRANCH=main
REMOTE=origin

# Commands, if they aren't simply "php" and "composer".
# PHP=/usr/bin/php8.3
# COMPOSER=/usr/local/bin/composer

# The user PHP-FPM runs as; storage/ is handed to it.
WEB_USER=www-data
# Reload PHP-FPM after a deploy (so OPcache drops old code), e.g. php8.3-fpm.
# PHP_FPM_SERVICE=php8.3-fpm

# Database backups before every deploy, outside the checkout.
# BACKUP_DIR=/var/backups/patriai
KEEP_BACKUPS=10

# 1 = put the API in maintenance mode while it updates (recommended).
MAINTENANCE=1

# Public address to check after a deploy (otherwise APP_URL from patriai-api/.env).
# HEALTH_URL=https://ecofuelglobal.com

# Admin panel (Next.js). 1 = build and restart it too.
DEPLOY_ADMIN=0
ADMIN_PM2_NAME=patriai-admin
ADMIN_PORT=3111
# Where the admin panel finds the API.
# API_ORIGIN=https://ecofuelglobal.com
